    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Game variables
            const gameBoard = document.getElementById('gameBoard');
            const timerDisplay = document.getElementById('timer');
            const movesDisplay = document.getElementById('moves');
            const pairsDisplay = document.getElementById('pairs');
            const totalPairsDisplay = document.getElementById('totalPairs');
            const restartBtn = document.getElementById('restartBtn');
            const newGameBtn = document.getElementById('newGameBtn');
            const difficultyBtns = document.querySelectorAll('.difficulty-btn');
            const finalTimeDisplay = document.getElementById('finalTime');
            const finalMovesDisplay = document.getElementById('finalMoves');
            const newHighScoreAlert = document.getElementById('newHighScore');
            const playAgainBtn = document.getElementById('playAgainBtn');
            const shareBtn = document.getElementById('shareBtn');
            const howToPlayBtn = document.getElementById('howToPlayBtn');
            const highScoresBtn = document.getElementById('highScoresBtn');
            const modals = document.querySelectorAll('.modal');
            const closeModalBtns = document.querySelectorAll('.close-modal');
            
            let cards = [];
            let hasFlippedCard = false;
            let lockBoard = false;
            let firstCard, secondCard;
            let moves = 0;
            let pairs = 0;
            let totalPairs = 0;
            let timer;
            let seconds = 0;
            let isTimerRunning = false;
            let currentDifficulty = 'easy';
            let gameStarted = false;
            
            // Emoji collection
            const emojis = [
                '😀', '😁', '😂', '😃', '😄', '😅', '😆', '😉', '😊', '😋', 
                '😎', '😍', '😘', '🥰', '😗', '😙', '😚', '🙂', '🤗', '🤩',
                '🤔', '🤨', '😐', '😑', '😶', '🙄', '😏', '😣', '😥', '😮',
                '🥺', '😯', '😪', '😫', '😴', '😌', '😛', '😜', '😝', '🤤',
                '😒', '😓', '😔', '😕', '🙃', '🤑', '😲', '☹️', '🙁', '😖',
                '😞', '😟', '😤', '😢', '😭', '😦', '😧', '😨', '😩', '🤯',
                '😬', '😰', '😱', '🥵', '🥶', '😳', '🤪', '😵', '😡', '😠',
                '🤬', '😷', '🤒', '🤕', '🤢', '🤮', '🤧', '😇', '🥳', '🥴'
            ];

            // Difficulty settings
            const difficulties = {
                easy: { pairs: 6, cols: 'grid-cols-2 sm:grid-cols-4' },
                medium: { pairs: 10, cols: 'grid-cols-2 sm:grid-cols-4 lg:grid-cols-5' },
                hard: { pairs: 15, cols: 'grid-cols-2 sm:grid-cols-4 lg:grid-cols-6' }
            };

            // Initialize game
            function initGame() {
                resetGame();
                createCards();
                updateStats();
            }

            // Create cards based on difficulty
            function createCards() {
                const pairsCount = difficulties[currentDifficulty].pairs;
                totalPairs = pairsCount;
                totalPairsDisplay.textContent = totalPairs;
                
                // Update grid columns based on difficulty
                gameBoard.className = `grid gap-4 md:w-5/6 order-1 md:order-2 ${difficulties[currentDifficulty].cols}`;
                
                // Select random emojis based on pairs count
                const shuffledEmojis = emojis.sort(() => 0.5 - Math.random()).slice(0, pairsCount);
                const cardEmojis = [...shuffledEmojis, ...shuffledEmojis];
                cardEmojis.sort(() => 0.5 - Math.random());
                
                // Clear game board
                gameBoard.innerHTML = '';
                cards = [];
                
                // Create card elements
                cardEmojis.forEach((emoji, index) => {
                    const card = createCardElement(emoji, index);
                    gameBoard.appendChild(card);
                    cards.push(card);
                });
            }

            // Create a single card element
            function createCardElement(emoji, index) {
                const card = document.createElement('div');
                card.className = 'game-card aspect-square';
                card.dataset.index = index;
                card.dataset.emoji = emoji;
                
                card.innerHTML = `
                    <div class="game-card-inner h-full w-full">
                        <div class="game-card-front">${emoji}</div>
                        <div class="game-card-back">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        </div>
                    </div>
                `;
                
                card.addEventListener('click', flipCard);
                return card;
            }

            // Flip card when clicked
            function flipCard() {
                if (lockBoard) return;
                if (this === firstCard) return;

                // Start timer on first card flip
                if (!isTimerRunning) {
                    startTimer();
                    gameStarted = true;
                }
                
                this.classList.add('flipped');
                
                if (!hasFlippedCard) {
                    // First card flipped
                    hasFlippedCard = true;
                    firstCard = this;
                    return;
                }
                
                // Second card flipped
                secondCard = this;
                moves++;
                updateStats();
                
                checkForMatch();
            }

            // Check if the two flipped cards match
            function checkForMatch() {
                const isMatch = firstCard.dataset.emoji === secondCard.dataset.emoji;
                
                if (isMatch) {
                    disableCards();
                    pairs++;
                    updateStats();
                    
                    if (pairs === totalPairs) {
                        setTimeout(() => {
                            endGame();
                        }, 500);
                    }
                } else {
                    unflipCards();
                }
            }

            // Disable matched cards
            function disableCards() {
                firstCard.removeEventListener('click', flipCard);
                secondCard.removeEventListener('click', flipCard);
                
                firstCard.classList.add('matched');
                secondCard.classList.add('matched');
                
                resetBoardState();
            }

            // Unflip unmatched cards
            function unflipCards() {
                lockBoard = true;
                
                setTimeout(() => {
                    firstCard.classList.remove('flipped');
                    secondCard.classList.remove('flipped');
                    
                    resetBoardState();
                }, 1000);
            }

            // Reset board state after each turn
            function resetBoardState() {
                [hasFlippedCard, lockBoard] = [false, false];
                [firstCard, secondCard] = [null, null];
            }

            // Update game stats displays
            function updateStats() {
                movesDisplay.textContent = moves;
                pairsDisplay.textContent = pairs;
            }

            // Start timer
            function startTimer() {
                isTimerRunning = true;
                seconds = 0;
                timer = setInterval(() => {
                    seconds++;
                    updateTimerDisplay();
                }, 1000);
            }

            // Stop timer
            function stopTimer() {
                clearInterval(timer);
                isTimerRunning = false;
            }

            // Update timer display
            function updateTimerDisplay() {
                const minutes = Math.floor(seconds / 60);
                const remainingSeconds = seconds % 60;
                timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${remainingSeconds.toString().padStart(2, '0')}`;
            }

            // Reset game state
            function resetGame() {
                stopTimer();
                moves = 0;
                pairs = 0;
                seconds = 0;
                updateTimerDisplay();
                updateStats();
                resetBoardState();
                gameStarted = false;
            }

            // End game and show win modal
            function endGame() {
                stopTimer();
                
                // Update win modal with stats
                finalTimeDisplay.textContent = timerDisplay.textContent;
                finalMovesDisplay.textContent = moves;
                
                // Check if this is a new high score
                const isNewHighScore = checkAndSaveHighScore();
                newHighScoreAlert.classList.toggle('hidden', !isNewHighScore);
                
                // Show win modal
                showModal('winModal');
                
                // Create confetti effect
                createConfetti();
            }

            // Create confetti effect
            function createConfetti() {
                const confettiContainer = document.querySelector('#winModal');
                const colors = ['#f94144', '#f3722c', '#f8961e', '#f9c74f', '#90be6d', '#43aa8b', '#577590'];
                
                for (let i = 0; i < 100; i++) {
                    const confetti = document.createElement('div');
                    confetti.classList.add('confetti');
                    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.left = `${Math.random() * 100}%`;
                    confetti.style.animationDelay = `${Math.random() * 3}s`;
                    confetti.style.width = `${Math.random() * 10 + 5}px`;
                    confetti.style.height = `${Math.random() * 10 + 5}px`;
                    confettiContainer.appendChild(confetti);
                    
                    // Remove confetti after animation
                    setTimeout(() => {
                        confetti.remove();
                    }, 3000);
                }
            }

            // Check if current score is a high score and save it
            function checkAndSaveHighScore() {
                const highScores = JSON.parse(localStorage.getItem('emojiMatchHighScores')) || {};
                if (!highScores[currentDifficulty]) {
                    highScores[currentDifficulty] = [];
                }
                
                const score = {
                    moves: moves,
                    time: seconds,
                    date: new Date().toISOString()
                };
                
                // Sort by moves (ascending), then by time (ascending)
                highScores[currentDifficulty].push(score);
                highScores[currentDifficulty].sort((a, b) => {
                    if (a.moves === b.moves) {
                        return a.time - b.time;
                    }
                    return a.moves - b.moves;
                });
                
                // Keep only top 5 scores
                if (highScores[currentDifficulty].length > 5) {
                    highScores[currentDifficulty] = highScores[currentDifficulty].slice(0, 5);
                }
                
                localStorage.setItem('emojiMatchHighScores', JSON.stringify(highScores));
                
                // Check if the current score is in the top 5
                return highScores[currentDifficulty].some(s => s.moves === moves && s.time === seconds);
            }

            // Display high scores in the modal
            function displayHighScores() {
                const highScoresList = document.getElementById('highScoresList');
                const highScores = JSON.parse(localStorage.getItem('emojiMatchHighScores')) || {};
                
                highScoresList.innerHTML = '';
                
                let hasScores = false;
                
                for (const difficulty in highScores) {
                    if (highScores[difficulty].length > 0) {
                        hasScores = true;
                        
                        highScores[difficulty].forEach(score => {
                            const row = document.createElement('tr');
                            row.className = 'border-b';
                            
                            const difficultyCell = document.createElement('td');
                            difficultyCell.className = 'py-2 capitalize';
                            difficultyCell.textContent = difficulty;
                            
                            const movesCell = document.createElement('td');
                            movesCell.className = 'py-2';
                            movesCell.textContent = score.moves;
                            
                            const timeCell = document.createElement('td');
                            timeCell.className = 'py-2';
                            const minutes = Math.floor(score.time / 60);
                            const seconds = score.time % 60;
                            timeCell.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                            
                            const dateCell = document.createElement('td');
                            dateCell.className = 'py-2';
                            dateCell.textContent = new Date(score.date).toLocaleDateString();
                            
                            row.appendChild(difficultyCell);
                            row.appendChild(movesCell);
                            row.appendChild(timeCell);
                            row.appendChild(dateCell);
                            
                            highScoresList.appendChild(row);
                        });
                    }
                }
                
                if (!hasScores) {
                    const emptyRow = document.createElement('tr');
                    const cell = document.createElement('td');
                    cell.colSpan = 4;
                    cell.className = 'py-4 text-center text-gray-500';
                    cell.textContent = 'No high scores yet. Play a game to set some records!';
                    emptyRow.appendChild(cell);
                    highScoresList.appendChild(emptyRow);
                }
            }

            // Show modal
            function showModal(modalId) {
                const modal = document.getElementById(modalId);
                modal.classList.add('show');
                
                // If it's the high scores modal, refresh the scores
                if (modalId === 'highScoresModal') {
                    displayHighScores();
                }
            }

            // Hide all modals
            function hideAllModals() {
                modals.forEach(modal => {
                    modal.classList.remove('show');
                });
            }

            // Share results function
            function shareResults() {
                const text = `I just completed the Emoji Match Game in ${finalTimeDisplay.textContent} with ${finalMovesDisplay.textContent} moves! Can you beat my score?`;
                
                // Check if Web Share API is supported
                if (navigator.share) {
                    navigator.share({
                        title: 'Emoji Match Game Results',
                        text: text,
                        url: window.location.href
                    }).catch(error => console.log('Error sharing:', error));
                } else {
                    // Fallback to clipboard
                    navigator.clipboard.writeText(text)
                        .then(() => {
                            alert('Results copied to clipboard! Share it with your friends.');
                        })
                        .catch(err => {
                            console.error('Failed to copy: ', err);
                        });
                }
            }

            // Event listeners
            restartBtn.addEventListener('click', () => {
                if (gameStarted) {
                    resetGame();
                    createCards();
                    updateStats();
                }
            });
            
            newGameBtn.addEventListener('click', initGame);
            
            difficultyBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Update active difficulty button
                    difficultyBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    
                    // Update difficulty and restart game
                    currentDifficulty = btn.dataset.difficulty;
                    initGame();
                });
            });
            
            playAgainBtn.addEventListener('click', () => {
                hideAllModals();
                initGame();
            });
            
            shareBtn.addEventListener('click', shareResults);
            
            howToPlayBtn.addEventListener('click', () => showModal('howToPlayModal'));
            highScoresBtn.addEventListener('click', () => showModal('highScoresModal'));
            
            // Close modal when clicking close button or outside the modal content
            closeModalBtns.forEach(btn => {
                btn.addEventListener('click', hideAllModals);
            });
            
            modals.forEach(modal => {
                modal.addEventListener('click', (event) => {
                    if (event.target === modal) {
                        hideAllModals();
                    }
                });
            });

            // Initialize the game
            initGame();
        });
    </script>
</body>
</html>
